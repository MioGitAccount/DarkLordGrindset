script = ExtResource("1_script")
Name = "Bleed II"
Description = "A deep, dirty cut at an enemy it can reach. Unless blocked or dodged, the target bleeds for its next 3 turns, losing the attacker's full Deadliness each turn, ignoring defence, and it can't be healed until the bleeding stops. Ready again 3 turns later."
